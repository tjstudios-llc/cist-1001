# API server
NODE_ENV=development
PORT=4000

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-unique-random-secret

# Local SQLite database path (relative to apps/api when running its scripts)
DATABASE_URL=./data/dev.db

# Comma-separated list of trusted browser origins
CORS_ORIGINS=http://localhost:5173

# Optional GitHub OAuth application
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
